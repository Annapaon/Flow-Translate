{
  "name": "flow-translate",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:privacy": "node scripts/build-privacy-page.mjs",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",

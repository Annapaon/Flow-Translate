{
  "name": "flow-translate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:privacy": "node scripts/build-privacy-page.mjs",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write .",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "test:benchmark": "playwright test --config playwright.benchmark.config.ts",
    "test:acceptance:services": "vitest run --config vitest.live.config.ts",
    "test:acceptance:websites": "playwright test --config playwright.acceptance.config.ts",
    "dev:firefox": "wxt -b firefox",
    "build:firefox": "wxt build -b firefox",
    "zip:firefox": "wxt zip -b firefox && node scripts/package-firefox.mjs"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "parse5": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "spark-md5": "^3.0.2",
    "wxt": "^0.21.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/spark-md5": "^3.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "description": "支持划词、网页全文和长文本翻译的 Chrome/Edge/Firefox 浏览器扩展",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
